{
  "name": "edge-tts",
  "displayName": "Microsoft Edge TTS",
  "publisher": "e-novels",
  "version": "0.1.0",
  "description": "TTS Engine extension for e-novels by e-novels.",
  "starter": {
    "kind": "tts"
  },
  "engines": {
    "enovel": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "browser": "./dist/browser.js",
  "icon": "./public/icon.png",
  "activationEvents": [
    "always"
  ],
  "categories": [
    "TTS"
  ],
  "keywords": [
    "e-novels",
    "tts",
    "typescript"
  ],
  "permissions": [
    "tts",
    "network",
    "storage"
  ],
  "contributes": {
    "tts": {
      "name": "Microsoft Edge TTS",
      "description": "TTS Engine extension for e-novels by e-novels.",
      "mode": "cloud",
      "capabilities": [
        "getVoices",
        "speak",
        "stop"
      ]
    }
  }
}
