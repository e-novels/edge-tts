{
  "name": "example-extension",
  "displayName": "Example Extension",
  "publisher": "your-publisher",
  "version": "0.1.0",
  "description": "A fixture-backed template for e-novels scraper or theme extensions.",
  "starter": {
    "kind": "scraper"
  },
  "engines": {
    "enovel": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "browser": "./dist/browser.js",
  "icon": "./public/icon.png",
  "activationEvents": [
    "always"
  ],
  "categories": [
    "Scrapers"
  ],
  "keywords": [
    "e-novels",
    "scraper",
    "theme",
    "template",
    "typescript"
  ],
  "permissions": [
    "network",
    "reader"
  ],
  "network": {
    "allowedHosts": [
      "example.com"
    ]
  },
  "contributes": {
    "scraper": {
      "name": "Example Site",
      "description": "Replace the placeholder routes and mappers with a source you are allowed to access.",
      "version": 2,
      "site": {
        "name": "Example Site",
        "baseUrl": "https://example.com"
      },
      "capabilities": [
        "search",
        "getBookDetail",
        "getChapter"
      ],
      "search": {
        "pageSize": 20,
        "fields": [
          {
            "id": "query",
            "type": "text",
            "label": "Search"
          }
        ]
      }
    }
  }
}